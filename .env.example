DB_URL=jdbc:mysql://localhost:3306/ai_learn
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60s
OPENAI_MAX_COMPLETION_TOKENS=1000

CHAT_MEMORY_MAX_MESSAGES=20
CHAT_RECOVERY_SCAN_INTERVAL=10s
CHAT_SSE_HEARTBEAT_INTERVAL_MS=15000
CHAT_OUTBOX_RECOVERY_INTERVAL=10s
CHAT_OUTBOX_BATCH_SIZE=100
CHAT_OUTBOX_RETENTION=7d
CHAT_OUTBOX_CLEANUP_INTERVAL=1h
CHAT_REDIS_ENABLED=false
CHAT_EVENT_RETENTION=24h
CHAT_EVENT_MAX_PER_RUN=2000
CHAT_WEBSOCKET_SEND_TIME_LIMIT_MS=10000
CHAT_WEBSOCKET_BUFFER_SIZE_LIMIT_BYTES=1048576
CHAT_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=*
REDIS_URL=redis://localhost:6379/0
REDIS_CLIENT_NAME=ai-learn
REDIS_CONNECT_TIMEOUT=2s
REDIS_READ_TIMEOUT=5s
